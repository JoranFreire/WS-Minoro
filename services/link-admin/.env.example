PORT=8081
DATABASE_URL=postgres://postgres:postgres@postgres:5432/wsminoro?sslmode=disable
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-production-use-32-chars-minimum
FRONTEND_ORIGIN=http://localhost:3000
# Set to true in production (requires HTTPS) so session cookies are only sent over TLS.
COOKIE_SECURE=false

# Billing (Pagar.me) — all optional. Leave PAGARME_SECRET_KEY unset to run
# without billing (self-serve signup still works, tenants stay on the free
# plan). Create these in your own Pagar.me dashboard (test mode is fine for
# development) — none of these values are usable as-is.
PAGARME_SECRET_KEY=
# Basic Auth credentials you also set when registering the webhook URL in
# the Pagar.me dashboard — used to verify incoming webhook calls.
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=
# Plan IDs from Pagar.me's Plans (Planos) product, one per paid tier.
PAGARME_PLAN_ID_STARTER=
PAGARME_PLAN_ID_PRO=
PAGARME_PLAN_ID_BUSINESS=
